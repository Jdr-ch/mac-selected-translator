# Models and credentials are read from ~/.codex and ~/.qwen, never from this file.

# Local service consumed by the Swift app.
TRANSLATOR_BACKEND_HOST=127.0.0.1
TRANSLATOR_BACKEND_PORT=8765
TRANSLATOR_BACKEND_URL=http://127.0.0.1:8765

# Translation defaults and guardrails.
TRANSLATOR_MAX_INPUT_CHARS=8000
TRANSLATOR_REQUEST_TIMEOUT_SECONDS=120
