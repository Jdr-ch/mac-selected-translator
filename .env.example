# Required. You can also use QWEN_API_KEY if you prefer that name.
DASHSCOPE_API_KEY=sk-xxxx

# Default model requested by the macOS app.
QWEN_MODEL=qwen3.7-max

# If your Alibaba Cloud account uses a workspace endpoint, replace this with
# the full OpenAI-compatible /v1 URL from Model Studio.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Local service consumed by the Swift app.
TRANSLATOR_BACKEND_HOST=127.0.0.1
TRANSLATOR_BACKEND_PORT=8765
TRANSLATOR_BACKEND_URL=http://127.0.0.1:8765

# Translation defaults and guardrails.
DEFAULT_TARGET_LANGUAGE=中文
TRANSLATOR_MAX_INPUT_CHARS=8000
QWEN_REQUEST_TIMEOUT_SECONDS=30
